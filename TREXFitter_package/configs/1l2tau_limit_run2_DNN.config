% Auto-generated by Build_TRExFitter_Inputs.py from TREXFitter_configs/1l2tau_limit_run2.config (NTUP mode)
% DNN only. The five models score the SAME events, so each
% model gets its own config/Job - never merge them into one fit.

Job: hh1l2tau_run2_DNN
  Label: 1#ell2#tau
  CmeLabel: 13 TeV
  POI: mu_XS_hh
  ReadFrom: NTUP
  NtuplePath: ./ntuples
  NtupleName: "AnalysisMiniTree"
  MCweight: "w_phys"
  Lumi: 1.0
  LumiLabel: 140 fb^{-1}
  PlotOptions: NORMSIG, NOXERR, YIELDS, CHI2
  LegendX1: 0.6
  DebugLevel: 1
  HistoChecks: NOCRASH
  ImageFormat: pdf,png
  MCstatThreshold: 0.001
  MCstatConstraint: Poisson
  GetChi2: True
  StatOnly: False
  DoSummaryPlot: True
  SummaryPlotYmin: 0.05
  DoTables: True
  DoPieChartPlot: True
  KeepPrefitBlindedBins: TRUE
  RecreateBinningFiles: TRUE

Region: SR__DNN_RUN2
  Type: SIGNAL
  DataType: ASIMOV
  Label: HH 1#ell2#tau SR (DNN)
  Variable: "score_dnn",8,0.4,1
  VariableTitle: DNN score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_dnn>=0.4 && n_b_jet==0 && n_jet>=2 && fabs(dR_t1t2)<=2.0 && pair_isOStaus && pass_SLT

Region: LowMVA__DNN_RUN2
  Type: VALIDATION
  Label: HH 1#ell2#tau LowMVA (DNN)
  Variable: "score_dnn",8,0,0.4
  VariableTitle: DNN score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_dnn<0.4 && n_b_jet==0 && n_jet>=2 && fabs(dR_t1t2)<=2.0 && pair_isOStaus && pass_SLT

Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1
  UseMinos: mu_XS_hh

Limit: limit
  LimitType: ASYMPTOTIC
  LimitBlind: True
  POI: mu_XS_hh

