% Auto-generated by Build_TRExFitter_Inputs.py from TREXFitter_configs/2l2tau_limit_run2.config (NTUP mode)
% XGB only. The five models score the SAME events, so each
% model gets its own config/Job - never merge them into one fit.

% ----------------------------------------------------------------------
% FINAL-SELECTION FIX (hand-edited 2026-07-30)
% Added the channel final-state flag 'pass2l2tau' to both region Selections
% so the 2l2tau selection is explicit, per supervisor's comment that the
% plots did not include the final selection.
% MEASURED CAVEAT: pass2l2tau == 1 for all events in the run3 Zjets ntuple
% (73738/73738), i.e. the ntuples are already pre-filtered on it, so this
% line makes the cut explicit but does NOT change the yields on its own.
% If the intended 'final selection' is two IDENTIFIED (non-fake) taus,
% the meaningful cut is on tau ID instead. Swap the Selection lines for:
%   ... && tau1_base_id && tau2_base_id   (or:  && num_anti_tau==0)
% Confirm with supervisor first: that removes MC fake-tau events, which
% may conflict with the instruction to keep fakes from MC.
% ----------------------------------------------------------------------
Job: hh2l2tau_run2_XGB
  Label: 2#ell2#tau
  CmeLabel: 13 TeV
  POI: mu_XS_hh
  ReadFrom: NTUP
  NtuplePath: ./ntuples
  NtupleName: "AnalysisMiniTree"
  MCweight: "w_phys"
  Lumi: 1.0
  LumiLabel: 140 fb^{-1}
  PlotOptions: NORMSIG, NOXERR, YIELDS, CHI2
  LegendX1: 0.6
  DebugLevel: 1
  HistoChecks: NOCRASH
  ImageFormat: pdf,png
  MCstatThreshold: 0.001
  MCstatConstraint: Poisson
  GetChi2: True
  StatOnly: False
  DoSummaryPlot: True
  SummaryPlotYmin: 0.05
  DoTables: True
  DoPieChartPlot: True
  KeepPrefitBlindedBins: TRUE
  RecreateBinningFiles: TRUE

Region: SR__XGB_RUN2
  Type: SIGNAL
  DataType: ASIMOV
  Label: HH 2#ell2#tau SR (XGB)
  Variable: "score_xgboost",8,0.4,1
  VariableTitle: XGB score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_xgboost>=0.4 && pass2l2tau && n_b_jet==0 && l1_charge*l2_charge<0 && mZ_cut>0

Region: LowMVA__XGB_RUN2
  Type: VALIDATION
  Label: HH 2#ell2#tau LowMVA (XGB)
  Variable: "score_xgboost",8,0,0.4
  VariableTitle: XGB score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_xgboost<0.4 && pass2l2tau && n_b_jet==0 && l1_charge*l2_charge<0 && mZ_cut>0

Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1
  UseMinos: mu_XS_hh

Limit: limit
  LimitType: ASYMPTOTIC
  LimitBlind: True
  POI: mu_XS_hh

Sample: data_2l2tau_run2
  Type: DATA
  Title: data
  FillColor: 1
  NtupleFiles: Data/data_2l2tau_run2

Sample: HH_ggF
  Type: SIGNAL
  Title: HH ggF
  FillColorRGB: 237,34,37
  NtupleFiles: 2l2tau/run2/signal_ggF
  Group: "HH"

Sample: HH_VBF
  Type: SIGNAL
  Title: HH VBF
  FillColorRGB: 245,130,32
  NtupleFiles: 2l2tau/run2/signal_VBF
  Group: "HH"

Sample: ttbar
  Type: BACKGROUND
  Title: t#bar{t}
  FillColorRGB: 0,84,159
  NtupleFiles: 2l2tau/run2/ttbar
  Group: "t#bar{t}"

Sample: tops
  Type: BACKGROUND
  Title: Other top
  FillColorRGB: 122,181,229
  NtupleFiles: 2l2tau/run2/tops
  Group: "Other top"

Sample: SingleH
  Type: BACKGROUND
  Title: Single-H
  FillColorRGB: 139,69,19
  NtupleFiles: 2l2tau/run2/singleH
  Group: "Single-H"

Sample: VV
  Type: BACKGROUND
  Title: VV
  FillColorRGB: 202,198,88
  NtupleFiles: 2l2tau/run2/diboson
  Group: "VV"

Sample: VVV
  Type: BACKGROUND
  Title: VVV
  FillColorRGB: 135,187,175
  NtupleFiles: 2l2tau/run2/VVV
  Group: "VVV"

Sample: Vgamma
  Type: BACKGROUND
  Title: V#gamma
  FillColorRGB: 148,103,189
  NtupleFiles: 2l2tau/run2/Vgamma
  Group: "V#gamma"

Sample: Wjets
  Type: BACKGROUND
  Title: W+jets
  FillColorRGB: 56,154,179
  NtupleFiles: 2l2tau/run2/Wjets
  Group: "W+jets"

Sample: Zjets
  Type: BACKGROUND
  Title: Z+jets
  FillColorRGB: 0,158,115
  NtupleFiles: 2l2tau/run2/Zjets
  Group: "Z+jets"

NormFactor: mu_XS_hh
  Nominal: 1
  Min: -100
  Max: 500
  Samples: HH_*
  Regions: SR*

% No Systematic blocks, per supervisor - statistical-only fit
% (MC-stat gammas still included via MCstatThreshold).
