% Auto-generated by Build_TRExFitter_Inputs.py.
% Redraws hh1l2tau_run3_GNN's regions using the MultiFit result of combine_1l2tau_GNN.
% The combination stays a MultiFit (supervisor: run2 and run3 are at
% different energies / cross sections, so they must not be merged
% into one hand-written likelihood). Nothing is refitted here - only
% the region plots are redrawn with the combined fit's parameters.
%
% Identical to the fit config except for the Suffix below - the
% regions, samples and binning MUST stay byte-identical, since the
% `h` step reads the histograms the original job already wrote.
%
% PREREQUISITE (run_postfit_combined.sh does this for you):
%   cp combine_1l2tau_GNN/Fits/combine_1l2tau_GNN.txt \
%      hh1l2tau_run3_GNN/Fits/hh1l2tau_run3_GNN_combFit.txt
% then:
%   trex-fitter hp configs/1l2tau_postfit_run3_GNN_combFit.config
%
% Writes Plots/<region>_postFit_combFit.{png,pdf}, leaving the
% original single-run post-fit plots untouched.
%
% NB the stack will be the same as the single-run post-fit plot: the
% SR is DataType: ASIMOV at mu=1, so every gamma and mu fit to 1.000
% in BOTH fits (largest deviation across all 40 jobs: 4e-6). What
% changes is the uncertainty band, which is what this is for.

Job: hh1l2tau_run3_GNN
  Suffix: _combFit
  Label: 1#ell2#tau
  CmeLabel: 13.6 TeV
  POI: mu_XS_hh
  ReadFrom: NTUP
  NtuplePath: ./ntuples
  NtupleName: "AnalysisMiniTree"
  MCweight: "w_phys"
  Lumi: 1.0
  LumiLabel: 140 fb^{-1}
  PlotOptions: NORMSIG, NOXERR, YIELDS, CHI2
  LegendX1: 0.6
  DebugLevel: 1
  HistoChecks: NOCRASH
  ImageFormat: pdf,png
  MCstatThreshold: 0.001
  MCstatConstraint: Poisson
  GetChi2: True
  StatOnly: False
  DoSummaryPlot: True
  SummaryPlotYmin: 0.05
  DoTables: True
  DoPieChartPlot: True
  KeepPrefitBlindedBins: TRUE
  RecreateBinningFiles: TRUE

Region: SR__GNN_RUN3
  Type: SIGNAL
  DataType: ASIMOV
  Label: HH 1#ell2#tau SR (GNN)
  Variable: "score_gnn",8,0.4,1
  VariableTitle: GNN score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_gnn>=0.4 && n_b_jet==0 && n_jet>=2 && fabs(dR_t1t2)<=2.0 && pair_isOStaus && pass_SLT

Region: LowMVA__GNN_RUN3
  Type: VALIDATION
  Label: HH 1#ell2#tau LowMVA (GNN)
  Variable: "score_gnn",8,0,0.4
  VariableTitle: GNN score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_gnn<0.4 && n_b_jet==0 && n_jet>=2 && fabs(dR_t1t2)<=2.0 && pair_isOStaus && pass_SLT

Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1
  UseMinos: mu_XS_hh

Limit: limit
  LimitType: ASYMPTOTIC
  LimitBlind: True
  POI: mu_XS_hh

Sample: data_1l2tau_run3
  Type: DATA
  Title: data
  FillColor: 1
  NtupleFiles: Data/data_1l2tau_run3

Sample: HH_ggF
  Type: SIGNAL
  Title: HH ggF
  FillColorRGB: 237,34,37
  NtupleFiles: 1l2tau/run3/signal_ggF
  Group: "HH"

Sample: HH_VBF
  Type: SIGNAL
  Title: HH VBF
  FillColorRGB: 245,130,32
  NtupleFiles: 1l2tau/run3/signal_VBF
  Group: "HH"

Sample: ttbar
  Type: BACKGROUND
  Title: t#bar{t}
  FillColorRGB: 0,84,159
  NtupleFiles: 1l2tau/run3/ttbar
  Group: "t#bar{t}"

Sample: tops
  Type: BACKGROUND
  Title: Other top
  FillColorRGB: 122,181,229
  NtupleFiles: 1l2tau/run3/tops
  Group: "Other top"

Sample: SingleH
  Type: BACKGROUND
  Title: Single-H
  FillColorRGB: 139,69,19
  NtupleFiles: 1l2tau/run3/singleH
  Group: "Single-H"

Sample: VV
  Type: BACKGROUND
  Title: VV
  FillColorRGB: 202,198,88
  NtupleFiles: 1l2tau/run3/diboson
  Group: "VV"

Sample: VVV
  Type: BACKGROUND
  Title: VVV
  FillColorRGB: 135,187,175
  NtupleFiles: 1l2tau/run3/VVV
  Group: "VVV"

Sample: Vgamma
  Type: BACKGROUND
  Title: V#gamma
  FillColorRGB: 148,103,189
  NtupleFiles: 1l2tau/run3/Vgamma
  Group: "V#gamma"

Sample: Wjets
  Type: BACKGROUND
  Title: W+jets
  FillColorRGB: 56,154,179
  NtupleFiles: 1l2tau/run3/Wjets
  Group: "W+jets"

Sample: Zjets
  Type: BACKGROUND
  Title: Z+jets
  FillColorRGB: 0,158,115
  NtupleFiles: 1l2tau/run3/Zjets
  Group: "Z+jets"

NormFactor: mu_XS_hh
  Nominal: 1
  Min: -100
  Max: 500
  Samples: HH_*
  Regions: SR*

% No Systematic blocks, per supervisor - statistical-only fit
% (MC-stat gammas still included via MCstatThreshold).
