% Auto-generated by Build_TRExFitter_Inputs.py from TREXFitter_configs/2l2tau_limit_run2.config (NTUP mode)
% ALL-MODELS convenience config - same fits as the per-model
% configs (prefer those / run_all.sh). The five models' regions
% hold the SAME events, so NEVER run this file bare: pass
% Regions= with ONE model's pair (+ Suffix) to EVERY step:
%   trex-fitter nwd configs/2l2tau_limit_run2.config "Regions=SR__XGB_RUN2,LowMVA__XGB_RUN2:Suffix=_XGB"
%   trex-fitter fp  configs/2l2tau_limit_run2.config "Regions=SR__XGB_RUN2,LowMVA__XGB_RUN2:Suffix=_XGB"
%   trex-fitter l   configs/2l2tau_limit_run2.config "Regions=SR__XGB_RUN2,LowMVA__XGB_RUN2:Suffix=_XGB"
% then the same three lines for DNN, MLP, GNN, PNN.

Job: hh2l2tau_run2
  Label: 2#ell2#tau
  CmeLabel: 13 TeV
  POI: mu_XS_hh
  ReadFrom: NTUP
  NtuplePath: ./ntuples
  NtupleName: "AnalysisMiniTree"
  MCweight: "w_phys"
  Lumi: 1.0
  LumiLabel: 140 fb^{-1}
  PlotOptions: NORMSIG, NOXERR, YIELDS, CHI2
  LegendX1: 0.6
  DebugLevel: 1
  HistoChecks: NOCRASH
  ImageFormat: pdf,png
  MCstatThreshold: 0.001
  MCstatConstraint: Poisson
  GetChi2: True
  StatOnly: False
  DoSummaryPlot: True
  SummaryPlotYmin: 0.05
  DoTables: True
  DoPieChartPlot: True
  KeepPrefitBlindedBins: TRUE
  RecreateBinningFiles: TRUE

Region: SR__XGB_RUN2
  Type: SIGNAL
  DataType: ASIMOV
  Label: HH 2#ell2#tau SR (XGB)
  Variable: "score_xgboost",8,0.4,1
