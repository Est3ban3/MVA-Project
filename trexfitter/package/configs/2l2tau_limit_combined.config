Fit: fit
  FitType: SPLUSB
  FitRegion: CRSR
  POIAsimov: 1
  UseMinos: mu_XS_hh

Limit: limit
  LimitType: ASYMPTOTIC
  LimitBlind: True
  POI: mu_XS_hh

