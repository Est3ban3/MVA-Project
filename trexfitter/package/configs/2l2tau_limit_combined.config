% Auto-generated by Build_TRExFitter_Inputs.py from trexfitter/configs_original/2l2tau_limit_run2.config (NTUP mode)
% ALL-MODELS convenience config - same fits as the per-model
% configs (prefer those / run_all.sh). The five models' regions
% hold the SAME events, so NEVER run this file bare: pass
% Regions= with ONE model's pair (+ Suffix) to EVERY step:
%   trex-fitter nwd configs/2l2tau_limit_combined.config "Regions=SR__XGB_COMBINED,LowMVA__XGB_COMBINED:Suffix=_XGB"
%   trex-fitter fp  configs/2l2tau_limit_combined.config "Regions=SR__XGB_COMBINED,LowMVA__XGB_COMBINED:Suffix=_XGB"
%   trex-fitter l   configs/2l2tau_limit_combined.config "Regions=SR__XGB_COMBINED,LowMVA__XGB_COMBINED:Suffix=_XGB"
% then the same three lines for DNN, MLP, GNN, PNN.

Job: hh2l2tau_combined
  Label: 2#ell2#tau
  CmeLabel: 13+13.6 TeV
  POI: mu_XS_hh
  ReadFrom: NTUP
  NtuplePath: ./ntuples
  NtupleName: "AnalysisMiniTree"
  MCweight: "w_phys"
  Lumi: 1.0
  LumiLabel: 300 fb^{-1}
  PlotOptions: NORMSIG, NOXERR, YIELDS, CHI2
  LegendX1: 0.6
  DebugLevel: 1
  HistoChecks: NOCRASH
  ImageFormat: pdf,png
  MCstatThreshold: 0.001
  MCstatConstraint: Poisson
  GetChi2: True
  StatOnly: False
  DoSummaryPlot: True
  SummaryPlotYmin: 0.05
  DoTables: True
  DoPieChartPlot: True
  KeepPrefitBlindedBins: TRUE
  RecreateBinningFiles: TRUE

Region: SR__XGB_COMBINED
  Type: SIGNAL
  DataType: ASIMOV
  Label: HH 2#ell2#tau SR (XGB)
  Variable: "score_xgboost_comb",8,0.4,1
  VariableTitle: XGB score
  Binning: "AutoBin","Trafo60",4,4
  Selection: score_xgboost_comb>=0.4 && n_b_jet==0 && l1_charge*l2_charge<0 && mZ_cut>0 && fabs(dR_t1t2)<=2.0 && pair_isOStaus && low_mass_cut && (pass_SLT || pass_DLT)

Region: LowMVA__XGB_COMBINED
  Type: VALIDATION
  Label: HH 2#ell2#tau LowMVA (XGB)
  Variable: "score_xgboost_comb",8,0,0.4
