% -------------- %
% -- NormFactor -- %
% ---------------- %
NormFactor: mu_XS_hh
  Nominal: 1
  Min: -100
  Max: 100
  Samples: HH_kl1kt1*
  Regions: SR*

% --------------- %
% LUMINOSITY SYST %
% --------------- %

Systematic: "ATLAS_lumi"
  Title: "ATLAS_lumi"
  Type: OVERALL
  OverallUp: 0.0083
  OverallDown: -0.0083
  Exclude: FakeTau_SR, FakeTau_VR, FakeTau_CR_Zjet, FakeTau_CR_tt
  Category: Instrumental


% ---------------------------- %
% --- FAKE TAU SYSTEMATICS --- %
% ---------------------------- %

Systematic: "Fake_Closure_1l2tau"
  Title: "Fake factor method non-closure"
  Type: OVERALL
  OverallUp: 0.05
  OverallDown: -0.05
  Samples: FakeTau_SR, FakeTau_VR, FakeTau_CR_Zjet, FakeTau_CR_tt
  Category: DataDriven


% Overall theory uncertainty HH
Systematic: "THEO_XS_ggFHH_SCALEMTop"
  Title: "HH ggF XS Scale+MTop"
  Type: OVERALL
  Samples: HH_kl1kt1_SR, HH_kl1kt1_VR
  OverallUp: 0.06
  OverallDown: -0.23
  Exclude: FakeTau_SR, FakeTau_VR, FakeTau_CR_Zjet, FakeTau_CR_tt
  Category: Theory

Systematic: "THEO_XS_ggFHH_PDFAlphas"
  Title: "HH ggF XS PDF+Alphas"
  Type: OVERALL
  Samples: HH_kl1kt1_SR, HH_kl1kt1_VR
  OverallUp: 0.03
  OverallDown: -0.03
  Exclude: FakeTau_SR, FakeTau_VR, FakeTau_CR_Zjet, FakeTau_CR_tt
  Category: Theory
